<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.StoreController">
    <!-- BorderPane inside the AnchorPane -->
    <BorderPane prefWidth="800" prefHeight="600" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <!-- Top Section -->
        <top>
            <HBox spacing="10" alignment="CENTER" style="-fx-background-color: #333; -fx-padding: 10;">
                <Label text="Droplet Game Store" style="-fx-text-fill: white; -fx-font-size: 18;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="accountButton" text="Account" onAction="#onAccountClicked" />
                <Button fx:id="libraryButton" text="Library" onAction="#onLibraryClicked" />
                <Button fx:id="loginButton" onAction="#onLogoutClicked" text="Log Out" />
            </HBox>
        </top>

        <!-- Center Section -->
        <center>
            <ScrollPane fitToWidth="true" style="-fx-background-color: #444;">
                <!-- Using TilePane for dynamic game tiles -->
                <TilePane fx:id="gameTilePane" hgap="10" vgap="10" alignment="CENTER" style="-fx-padding: 10;">
                    <!-- Game tiles will be dynamically added here -->
                </TilePane>
            </ScrollPane>
        </center>

        <!-- Bottom Section as AnchorPane -->
        <bottom>
            <AnchorPane style="-fx-background-color: #333; -fx-padding: 10;">
                <TextField fx:id="searchField" promptText="Search games..." AnchorPane.leftAnchor="10" AnchorPane.bottomAnchor="10" />
                <Button text="Search" onAction="#onSearchClicked" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10" />
            </AnchorPane>
        </bottom>
    </BorderPane>
</AnchorPane>
